{
  "expo": {
    "name": "10k Steps",
    "slug": "10k-steps",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.corpogames.10ksteps",
      "infoPlist": {
        "NSHealthShareUsageDescription": "This app reads your step data to show your daily and monthly progress.",
        "NSHealthUpdateUsageDescription": "This app does not modify your health data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "fr.corpogames.steps10k",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false
        }
      ],
      "expo-localization"
    ],
    "scheme": "stepsobjective",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "1.1.1",
    "updates": {
      "url": "https://u.expo.dev/d40d0fb6-265c-4bec-bc3d-922f4dadd7ff",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d40d0fb6-265c-4bec-bc3d-922f4dadd7ff"
      }
    }
  }
}
