{
  "expo": {
    "name": "Walkever",
    "slug": "10k-steps",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.corpogames.10ksteps",
      "buildNumber": "1.1.12",
      "infoPlist": {
        "NSHealthShareUsageDescription": "This app reads your step data to show your daily and monthly progress.",
        "NSHealthUpdateUsageDescription": "This app does not modify your health data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "fr.davisor.walkever",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ],
      "versionCode": 5
    },
    "plugins": [
      "expo-router",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false
        }
      ],
      "expo-localization",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "scheme": "stepsobjective",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "1.1.3",
    "updates": {
      "url": "https://u.expo.dev/d40d0fb6-265c-4bec-bc3d-922f4dadd7ff",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d40d0fb6-265c-4bec-bc3d-922f4dadd7ff"
      }
    }
  }
}
